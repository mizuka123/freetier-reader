# freetier-reader 環境変数サンプル
# 手動構築: `scripts/init.sh` を実行すると、このファイルから .env を作り秘密値を自動生成します。
# Terraform 構築: cloud-init が .env を自動生成するため、この手順は不要です。

# 起動するオプション機能（カンマ区切り）
#   cloudflare : Cloudflare Tunnel で公開（推奨）
#   x          : IFTTT → X 投稿のフィード化
#   morss      : 全文取得の補助
#   rsshub     : RSSHub
COMPOSE_PROFILES=cloudflare,x

# 公開ホスト名（Cloudflare 上のサブドメイン）
READER_HOSTNAME=reader.example.com

# Miniflux 管理者（初回起動時のみ作成）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# PostgreSQL（初回起動時に DB に設定される。変更手順は docs/operations.md）
POSTGRES_PASSWORD=CHANGE_ME

# Miniflux を VM のローカルホストだけに公開するポート（SSH ポートフォワード用・API 用）
MINIFLUX_LOCAL_PORT=8080

# 画面テーマ（scripts/apply-theme.sh。docs/theme.md）
#   dads : デジタル庁デザインシステムを参考にした非公式テーマ（ライト/ダーク対応）
#   none : 何もしない（Miniflux の設定画面で自分で管理する）
MINIFLUX_THEME=dads
# true にすると Noto Sans JP を Google Fonts から読み込む（閲覧端末から Google へ通信が発生する）
MINIFLUX_THEME_WEB_FONT=false
# テーマ適用に使う Miniflux の API キー（管理者パスワードを変更した後は必須。設定 → API キー）
MINIFLUX_API_KEY=

# Cloudflare Tunnel のトークン（Terraform の出力 or ダッシュボードで取得）
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# x-webhook-rss
# IFTTT から呼ぶ URL: https://${READER_HOSTNAME}/hook/x/${X_WEBHOOK_TOKEN}
X_WEBHOOK_TOKEN=CHANGE_ME
# 受け付ける X アカウント（カンマ区切り、@ なし。空ならすべて受け付ける）
X_ALLOWED_USERS=
# IFTTT アカウントのタイムゾーン（CreatedAt の解釈に使用）
X_IFTTT_TZ_OFFSET=+09:00
X_MAX_ITEMS=200
# この時間（h）IFTTT から受信がなければ /status が異常を返す（0 で無効）。投稿頻度より長く設定
X_STALE_HOURS=72
# 自分でビルドしてレジストリに置いたイメージを使う場合のみ指定（例: ghcr.io/<you>/freetier-reader-x-webhook-rss:<tag>@sha256:...）。
# このリポジトリはビルド済みイメージを公開していないため、通常は空のまま（ローカルビルド）
# X_WEBHOOK_RSS_IMAGE=

# バックアップ
BACKUP_DIR=backups
# オフサイト（OCI Object Storage）。空ならローカルのみ
OCI_BACKUP_NAMESPACE=
OCI_BACKUP_BUCKET=
OCI_COMPARTMENT_OCID=
OCI_REGION=

# 死活監視（任意）: Healthchecks.io などの ping URL
#   HEALTHCHECK_PING_URL : scripts/monitor.sh（10 分ごと）
#   BACKUP_PING_URL      : scripts/backup.sh（毎日）
HEALTHCHECK_PING_URL=
BACKUP_PING_URL=

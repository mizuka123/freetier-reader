# Terraform が生成（infra/terraform/templates/env.tftpl）。
# Terraform 側の値を変えたら `terraform output -raw env_file` で再同期する（docs/terraform.md）。
COMPOSE_PROFILES=${compose_profiles}
READER_HOSTNAME=${reader_hostname}
ADMIN_USERNAME=${admin_username}
ADMIN_PASSWORD=${admin_password}
POSTGRES_PASSWORD=${postgres_password}
MINIFLUX_LOCAL_PORT=8080
MINIFLUX_THEME=${miniflux_theme}
MINIFLUX_THEME_WEB_FONT=${theme_web_font}
MINIFLUX_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=${tunnel_token}
X_WEBHOOK_TOKEN=${webhook_token}
X_ALLOWED_USERS=${x_allowed_users}
X_IFTTT_TZ_OFFSET=${ifttt_tz_offset}
X_MAX_ITEMS=200
X_STALE_HOURS=${x_stale_hours}
%{ if x_webhook_rss_image != "" ~}
X_WEBHOOK_RSS_IMAGE=${x_webhook_rss_image}
%{ endif ~}
BACKUP_DIR=${backup_dir}
OCI_BACKUP_NAMESPACE=${backup_namespace}
OCI_BACKUP_BUCKET=${backup_bucket}
OCI_COMPARTMENT_OCID=${compartment_ocid}
OCI_REGION=${region}
HEALTHCHECK_PING_URL=${healthcheck_ping_url}
BACKUP_PING_URL=${backup_ping_url}

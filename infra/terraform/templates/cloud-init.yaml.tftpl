#cloud-config
# VM 初回起動時の構築。処理本体は /usr/local/sbin/freetier-reader-bootstrap.sh（失敗時は検知・通知する）。
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - git
  - cron
  - curl
  - unattended-upgrades

write_files:
  - path: /root/freetier-reader.env
    encoding: b64
    content: ${env_file_b64}
    permissions: "0600"

  # コンテナからインスタンスメタデータ（169.254.0.0/16）と VCN 内部への通信を遮断（SSRF 対策）。
  # ただし VCN の DNS リゾルバ（169.254.169.254:53）だけは許可する。
  - path: /usr/local/sbin/freetier-reader-egress-guard.sh
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      iptables -N DOCKER-USER 2>/dev/null || true
      for dst in 169.254.0.0/16 ${vcn_cidr}; do
        iptables -C DOCKER-USER -d "$dst" -j DROP 2>/dev/null || iptables -I DOCKER-USER -d "$dst" -j DROP
        iptables -C DOCKER-USER -d "$dst" -j DROP
      done
      # -I は先頭に挿入するため、DROP より後に入れた許可ルールが先に評価される
      for proto in udp tcp; do
        iptables -C DOCKER-USER -d 169.254.169.254 -p "$proto" --dport 53 -j RETURN 2>/dev/null \
          || iptables -I DOCKER-USER -d 169.254.169.254 -p "$proto" --dport 53 -j RETURN
        iptables -C DOCKER-USER -d 169.254.169.254 -p "$proto" --dport 53 -j RETURN
      done

  - path: /etc/systemd/system/freetier-reader-egress-guard.service
    content: |
      [Unit]
      Description=Block container access to instance metadata and VCN
      Before=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/freetier-reader-egress-guard.sh

      [Install]
      WantedBy=multi-user.target

  # Docker はデータボリュームのマウントと egress guard の適用が終わるまで起動しない
  # （マウント前に起動すると空の data-root で起動し、データが消えたように見えるため）
  - path: /etc/systemd/system/docker.service.d/10-freetier-reader.conf
    content: |
      [Unit]
      RequiresMountsFor=${data_mount}
      Requires=freetier-reader-egress-guard.service
      After=freetier-reader-egress-guard.service

  # OS のセキュリティ更新は自動適用、必要なら 04:30 JST（19:30 UTC）に自動再起動
  - path: /etc/apt/apt.conf.d/52freetier-reader
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "19:30";

  - path: /etc/cron.d/freetier-reader
    content: |
      # バックアップ: 毎日 03:30 JST（18:30 UTC）
      30 18 * * * root /opt/freetier-reader/scripts/backup.sh >> /var/log/freetier-reader-backup.log 2>&1
      # 監視: 10 分ごと
      */10 * * * * root /opt/freetier-reader/scripts/monitor.sh >> /var/log/freetier-reader-monitor.log 2>&1
      # 自動更新: 毎週日曜 04:00 JST（土曜 19:00 UTC）。Terraform 変数 auto_update で切り替え
      ${auto_update ? "0 19 * * 6 root /opt/freetier-reader/scripts/update.sh --auto >> /var/log/freetier-reader-update.log 2>&1" : "# (auto_update = false)"}

  - path: /etc/logrotate.d/freetier-reader
    content: |
      /var/log/freetier-reader-*.log {
        weekly
        rotate 8
        compress
        missingok
        notifempty
      }

  - path: /usr/local/sbin/freetier-reader-bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -Eeuo pipefail
      exec > >(tee -a /var/log/freetier-reader-bootstrap.log) 2>&1

      PING_URL='${healthcheck_ping_url}'
      MOUNT='${data_mount}'
      DATA_BYTES=$((${data_volume_gb} * 1024 * 1024 * 1024))
      STATE=/var/lib/freetier-reader
      mkdir -p "$STATE"

      fail() {
        echo "BOOTSTRAP FAILED at line $1"
        touch "$STATE/bootstrap.failed"
        sleep 2  # tee がログを書き終えるのを待つ
        if [ -n "$PING_URL" ]; then
          tail -n 50 /var/log/freetier-reader-bootstrap.log | curl -fsS -m 10 --retry 3 -o /dev/null --data-binary @- "$PING_URL/fail" || true
        fi
      }
      trap 'fail $LINENO' ERR

      retry() {
        local n
        for n in 1 2 3 4 5; do
          "$@" && return 0
          echo "retry $n/5: $*"
          sleep $((n * 15))
        done
        return 1
      }

      # ---- データ用ブロックボリューム（アタッチ完了まで最大 15 分待つ） ----
      # ラベル ftr-data があればそれを使う。なければ「未使用・容量が一致する」ディスクが
      # ちょうど 1 台の場合だけ初期化する（曖昧なら何もせず失敗）
      find_data_disk() {
        local d candidates=()
        if [ -e /dev/disk/by-label/ftr-data ]; then readlink -f /dev/disk/by-label/ftr-data; return 0; fi
        for d in $(lsblk -dpno NAME,TYPE | awk '$2 == "disk" { print $1 }'); do
          lsblk -no MOUNTPOINTS "$d" | grep -q . && continue
          [ "$(lsblk -no NAME "$d" | wc -l)" -eq 1 ] || continue
          blkid "$d" >/dev/null 2>&1 && continue
          [ "$(lsblk -bdno SIZE "$d")" -eq "$DATA_BYTES" ] || continue
          candidates+=("$d")
        done
        if [ "$${#candidates[@]}" -gt 1 ]; then
          echo "multiple candidate data disks: $${candidates[*]}" >&2
          return 2
        fi
        [ "$${#candidates[@]}" -eq 1 ] && echo "$${candidates[0]}"
      }
      disk=""
      for _ in $(seq 1 90); do
        rc=0
        disk="$(find_data_disk)" || rc=$?
        [ "$rc" -eq 2 ] && false
        [ -n "$disk" ] && break
        sleep 10
      done
      [ -n "$disk" ] || { echo "data volume (${data_volume_gb} GB) not found"; false; }
      if ! blkid "$disk" >/dev/null 2>&1; then
        mkfs.ext4 -q -L ftr-data "$disk"
      fi
      mkdir -p "$MOUNT"
      grep -q 'LABEL=ftr-data' /etc/fstab || echo "LABEL=ftr-data $MOUNT ext4 defaults,nofail 0 2" >> /etc/fstab
      systemctl daemon-reload
      mountpoint -q "$MOUNT" || mount "$MOUNT"
      mkdir -p "$MOUNT/docker" "$MOUNT/backups"

      # ---- Docker（データはデータボリュームに置く） ----
      systemctl enable --now freetier-reader-egress-guard.service
      mkdir -p /etc/docker
      printf '{\n  "data-root": "%s/docker",\n  "log-driver": "local"\n}\n' "$MOUNT" > /etc/docker/daemon.json
      systemctl restart docker
      systemctl enable docker

      # ---- アプリ ----
      if [ ! -d /opt/freetier-reader/.git ]; then
        retry git clone --branch '${repo_ref}' '${repo_url}' /opt/freetier-reader
      fi
      if [ -f /root/freetier-reader.env ]; then
        install -m 600 /root/freetier-reader.env /opt/freetier-reader/.env
        rm -f /root/freetier-reader.env
      fi
      cd /opt/freetier-reader
      retry docker compose pull --ignore-buildable
      docker compose up -d --build --wait
      # 画面テーマ（失敗しても構築は続行。後から scripts/apply-theme.sh で再実行できる）
      ./scripts/apply-theme.sh || echo "WARNING: theme was not applied; run scripts/apply-theme.sh later"

      rm -f "$STATE/bootstrap.failed"
      touch "$STATE/bootstrap.ok"
      echo "BOOTSTRAP OK"
      [ -z "$PING_URL" ] || curl -fsS -m 10 --retry 3 -o /dev/null "$PING_URL" || true

runcmd:
  - [/usr/local/sbin/freetier-reader-bootstrap.sh]

# state を OCI Object Storage（S3 互換 API）に置く場合の例。
# 使う場合は backend.tf にリネームし、Customer Secret Key を AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY に設定して
# `terraform init -migrate-state` を実行する。
terraform {
  backend "s3" {
    bucket                      = "freetier-reader-tfstate"
    key                         = "terraform.tfstate"
    region                      = "ap-tokyo-1"
    endpoints                   = { s3 = "https://<namespace>.compat.objectstorage.ap-tokyo-1.oraclecloud.com" }
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = true
  }
}
